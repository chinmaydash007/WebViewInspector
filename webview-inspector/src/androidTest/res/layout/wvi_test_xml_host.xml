<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/wvi_test_container" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp">
    <Button android:id="@id/wvi_test_touch" android:layout_width="match_parent" android:layout_height="48dp" android:text="Host touch target" />
    <EditText android:id="@id/wvi_test_edit" android:layout_width="match_parent" android:layout_height="48dp"
        android:inputType="text" android:hint="Keyboard test" />
    <WebView android:id="@id/wvi_test_webview" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <WebView android:id="@id/wvi_test_webview" android:layout_width="match_parent" android:layout_height="120dp" />
</LinearLayout>
