<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/headers"
        android:textAppearance="@style/SampleTitle" />

    <TextView
        android:id="@+id/headers_explainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:text="@string/headers_summary_release"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        android:textColor="@color/sample_muted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_demo"
            style="@style/SampleButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/send_headers" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_empty"
            style="@style/SampleTonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/send_without_headers" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/SamplePanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/receipt_title"
                android:textAppearance="@style/SampleSectionTitle" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="4dp">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/receipt_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:indeterminate="true"
                    android:visibility="invisible"
                    app:trackCornerRadius="2dp"
                    app:trackThickness="3dp" />
            </FrameLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/receipt_notice"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                app:cardBackgroundColor="@color/sample_container"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/receipt_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:minHeight="28dp"
                        android:text="@string/receipt_idle"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/sample_muted" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/retry"
                        style="@style/SampleTonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/receipt_retry"
                        android:visibility="gone"
                        app:icon="@drawable/ic_retry"
                        app:iconSize="18dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/sample_surface"
                app:cardCornerRadius="16dp">

                <WebView
                    android:id="@+id/receipt_web"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <View
                    android:id="@+id/receipt_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/sample_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
